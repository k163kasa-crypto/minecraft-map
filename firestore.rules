rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Prototype: anonymous-authenticated users can read/write room documents.
    // Anyone who knows a room code can edit that room. Share codes only with trusted friends.
    match /rooms/{roomId}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
